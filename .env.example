HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Host episode-edit notifications (SMTP — defaults are for Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
# Resend API key (re_...)
SMTP_PASSWORD=tobemodified
# Sender address — must be on a domain verified in Resend
EMAIL_FROM=noreply@yourdomain.com
# Where host replies go (optional; defaults to EMAIL_FROM)
EMAIL_REPLY_TO=you@gmail.com
# Secret used to sign episode-edit magic links (openssl rand -base64 32)
EPISODE_EDIT_JWT_SECRET=tobemodified
# Host notification emails are ON by default; set to false to pause them
# (do this before CSV bulk imports, or in local dev if you don't want real emails)
EPISODE_EDIT_NOTIFY_ENABLED=true
